# Environment & Server Config
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/printpass

# Security & Authentication
JWT_SECRET=supersecret_jwt_signing_key_at_least_32_characters_long_12345
COOKIE_SECRET=supersecret_cookie_secret_12345
AGENT_SIGNING_SECRET=supersecret_agent_signature_key_98765

# Client Origin (CORS & Socket.io)
CLIENT_URL=http://localhost:5173

# Razorpay Payments (Leave blank or unset to activate MOCK payment provider automatically)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email via Nodemailer (Optional - leaves empty to skip silently)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PrintPass <no-reply@printpass.local>
